# Server-only secrets. Never expose these through NEXT_PUBLIC_* variables.
HY_SUPABASE_URL=https://jfvbikivtpfjgfsnggiz.supabase.co
HY_SUPABASE_SERVICE_ROLE_KEY=

# Protects the scan endpoint when invoked by Supabase Cron.
HY_CRON_SECRET=
HY_STRATEGY_ADMIN_SECRET=

# Binance public Futures REST API; no account or trading key is needed.
HY_BINANCE_API_BASE_URL=https://fapi.binance.com
HY_BINANCE_REQUEST_DELAY_MS=0

# Gmail SMTP with a Google App Password.
HY_GMAIL_SMTP_HOST=smtp.gmail.com
HY_GMAIL_SMTP_PORT=587
HY_GMAIL_SMTP_USER=
HY_GMAIL_SMTP_APP_PASSWORD=
HY_GMAIL_RECIPIENT=

# Project defaults. Values can be changed without code edits.
HY_DEFAULT_TIMEZONE=Asia/Shanghai
HY_SCAN_TIMEFRAMES=15m,1h,4h
HY_TOP_SYMBOLS=10
HY_SCAN_BATCH_SIZE=10
HY_MAX_EMAILS_PER_SCAN=6
HY_MIN_SIGNAL_SCORE=80
HY_SIGNAL_SIDE_FILTER=SHORT
HY_SIGNAL_STRATEGY_FAMILY=TREND
HY_STRATEGY_VERSION=hy-paper-candidate-v2
HY_STRATEGY_SOURCE=DB
# PAPER is alert-and-ledger observation only. ACTIVE remains blocked until the
# larger forward OOS gate passes.
HY_STRATEGY_STAGE=PAPER
HY_PAPER_APPROVAL_MIN_OOS_SIGNALS=20
HY_STRATEGY_APPROVAL_MIN_PF=1.2
HY_STRATEGY_APPROVAL_MIN_OOS_SIGNALS=200
HY_STRATEGY_APPROVAL_MAX_DRAWDOWN_PERCENT=12
HY_STRATEGY_ENTRY_MODE=TREND_PULLBACK
HY_STRATEGY_STOP_ATR_MULTIPLIER=0.75
HY_STRATEGY_REWARD_RISK=2
HY_STRICT_REGIME_ALIGNMENT=true
HY_GLOBAL_REGIME_ALIGNMENT=true
HY_GLOBAL_REFERENCE_SYMBOL=BTCUSDT
HY_GLOBAL_REFERENCE_TIMEFRAME=4h
HY_SIGNAL_COOLDOWN_HOURS=24
HY_SIGNAL_STARVATION_HOURS=168
HY_MAX_EXECUTION_COST_RISK_FRACTION=0.1
HY_STRATEGY_RISK_PER_TRADE_USDT=50
HY_STRATEGY_MAX_POSITION_NOTIONAL_USDT=10000
HY_REQUEST_CONCURRENCY=5
HY_MARGIN_USDT=100
HY_PER_SIGNAL_RISK_CAP_USDT=50
HY_DAILY_RISK_BUDGET_USDT=600
HY_ASSUMED_LEVERAGE=20
HY_NEW_EMAIL_DAILY_CAP=10
HY_MAX_HOLD_HOURS=48
HY_INITIAL_PAPER_CAPITAL_USDT=10000
HY_PAPER_TRADING_ENABLED=true
# Optional paper-only A/B exit comparison. It creates a second ledger row per
# signal; it does not send a second email or place exchange orders.
HY_PAPER_EXIT_AB_ENABLED=false
HY_PAPER_EXIT_AB_REWARD_RISK=2.5
HY_PAPER_TAKER_FEE_RATE=0.0004
HY_PAPER_SLIPPAGE_BPS=2
HY_PAPER_SETTLEMENT_BATCH_SIZE=100
HY_MICROSTRUCTURE_ENABLED=false
HY_MICROSTRUCTURE_DEPTH_LIMIT=20
HY_MICROSTRUCTURE_TRADE_LIMIT=100
HY_DRY_RUN=true

# Local-only historical data directory used by the monthly optimizer.
HY_OPTIMIZER_DATA_DIR=data/raw

# Validation/backtest universe. Defaults to the top 50 USDT-M perpetuals by 24h quote volume; use 100 for top 100.
HY_VALIDATION_SYMBOL_COUNT=50
HY_BACKTEST_SYMBOL_COUNT=50
HY_VALIDATION_FOCUS=calibrated-trend-selected
HY_VALIDATION_OFFLINE=false

# Optional validation controls.
HY_VALIDATION_SYMBOLS=
HY_VALIDATION_END_TIME=
HY_VALIDATION_MIN_SCORE=60
HY_VALIDATION_FEE_RATE=0.0004
HY_VALIDATION_SLIPPAGE_BPS=2
HY_VALIDATION_CONCURRENCY=1
HY_VALIDATION_INTER_SYMBOL_DELAY_MS=2000
HY_VALIDATION_VARIANT_IDS=

# Optional backtest controls.
HY_BACKTEST_SYMBOLS=
HY_BACKTEST_SIDE_FILTER=SHORT
HY_BACKTEST_STRATEGY_FAMILY=TREND
HY_BACKTEST_MIN_SCORE=70
HY_BACKTEST_FEE_RATE=0.0004
HY_BACKTEST_SLIPPAGE_BPS=2
HY_BACKTEST_CONCURRENCY=2

# Optional local history downloader. Keep the symbol list bounded on free plans.
HY_HISTORY_SYMBOLS=BTCUSDT,ETHUSDT
HY_HISTORY_DAYS=400
HY_HISTORY_TIMEFRAMES=15m,1h,4h
HY_HISTORY_CONCURRENCY=2
